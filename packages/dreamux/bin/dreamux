#!/usr/bin/env node
// Resolve the installed launcher, including npm-link and nested symlinks,
// independently of cwd. Published packages already contain the compiled CLI.
import { spawn } from 'node:child_process';
import { access, realpath } from 'node:fs/promises';
import { constants } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const bin = await realpath(fileURLToPath(import.meta.url));
const target = join(dirname(bin), '..', 'dist', 'cli', 'dreamux.js');
try {
  await access(target);
} catch {
  console.error(`dreamux: ${target} is missing.`);
  console.error(
    'Build it first from the repo root: node common/scripts/install-run-rush.js build (rush build).',
  );
  process.exit(1);
}

process.env.DREAMUX_BIN = bin;
const nodeBin = process.env.DREAMUX_NODE_BIN;
if (nodeBin && nodeBin !== process.execPath) {
  const child = spawn(nodeBin, [target, ...process.argv.slice(2)], {
    stdio: 'inherit',
    windowsHide: true,
  });
  for (const signal of ['SIGINT', 'SIGTERM']) {
    process.on(signal, () => child.kill(signal));
  }
  child.once('error', (error) => {
    console.error(`dreamux: ${error.message}`);
    process.exitCode = 1;
  });
  child.once('exit', (code, signal) => {
    process.exitCode = code ?? 128 + (constants.signals[signal] ?? 1);
  });
} else {
  await import(pathToFileURL(target).href);
}
