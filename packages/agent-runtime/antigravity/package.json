{
  "name": "@excitedjs/agent-runtime-antigravity",
  "version": "0.2.0",
  "description": "External Antigravity CLI Agent Runtime provider for Dreamux, with config-selected native tmux and resident ACP v1 transports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/excitedjs/dreamux.git",
    "directory": "packages/agent-runtime/antigravity"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "engines": {
    "node": ">=22.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check . \"!**/*.md\" \"!**/dist/**\" \"!**/CHANGELOG.json\" \"!**/.rush/**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../../common/scripts/clean.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.0",
    "@excitedjs/dreamux-types": "workspace:*",
    "@excitedjs/dreamux-utils": "workspace:*"
  },
  "devDependencies": {
    "@excitedjs/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
