{
  "name": "@excitedjs/dreamux-utils",
  "version": "0.7.0",
  "description": "Shared utilities for Dreamux providers and host: neutral config validation, native OS/filesystem capabilities, and completion-body resolution. Independent of Dreamux core and provider types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/excitedjs/dreamux.git",
    "directory": "packages/dreamux-utils"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check . \"!**/*.md\" \"!**/dist/**\" \"!**/CHANGELOG.json\" \"!**/.rush/**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../common/scripts/clean.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@excitedjs/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
