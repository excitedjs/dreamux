node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example

# runtime state
.runtime/
~/.codex-host/

# dispatcher/teammate runtime work area (worktrees, work dirs, local scratch);
# never committed — same posture as .agents/wip/ below
.workspace/

# editor
.vscode/
.idea/

# rush / pnpm workspace produced by `rush update`
common/temp/
common/deploy/
common/autoinstallers/*/node_modules/

# rush per-project build/test caches and logs (transient; contain local paths)
**/.rush/temp/

# The only committed lockfile is common/config/rush/pnpm-lock.yaml (the source
# of truth for the whole workspace). The per-package npm path is retired — no
# per-package package-lock.json is committed. See
# .agents/decisions/0006-install-model.md.

# .agents/wip/ is local scratch (design notes, plans) — never committed.
# It is orphan-checked by .agents/scripts/check.sh and must stay out of the KB.
.agents/wip/
