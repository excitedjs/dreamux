/**
 * Rush config for the dreamux monorepo (issue #4).
 *
 * Toolchain choices:
 *   - Rush 5.140.x: stable line that integrates cleanly with pnpm 9.
 *   - pnpm 9.15.x: keeps lockfile compatible with current pnpm releases.
 *   - Node >= 22.7.0: matches the runtime requirement of the dreamux server
 *     (per @excitedjs/dreamux package.json's engines.node field).
 *
 * Projects today include @excitedjs/dreamux, @excitedjs/dreamux-types,
 * @excitedjs/dreamux-utils, the built-in agent-runtime packages, the Feishu
 * channel/transport packages, and the unpublished shared ESLint config, wired
 * with pnpm workspace:*.
 * More packages go under packages/<name>/ and get registered in the
 * `projects` array below.
 *
 * Install / build / test:
 *   node common/scripts/install-run-rush.js update
 *   node common/scripts/install-run-rush.js build
 *   node common/scripts/install-run-rush.js test
 * (Or `npm install -g @microsoft/rush@5.140.0` once, then `rush update`.)
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",
  "rushVersion": "5.140.0",
  "pnpmVersion": "9.15.0",
  "pnpmOptions": {
    "useWorkspaces": true,
    "strictPeerDependencies": false
  },
  "nodeSupportedVersionRange": ">=22.7.0",
  "ensureConsistentVersions": false,
  "projectFolderMinDepth": 2,
  "projectFolderMaxDepth": 3,
  "projects": [
    {
      "packageName": "@excitedjs/eslint-config",
      "projectFolder": "packages/eslint-config",
      "shouldPublish": false
    },
    {
      "packageName": "@excitedjs/dreamux-types",
      "projectFolder": "packages/dreamux-types",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/dreamux-utils",
      "projectFolder": "packages/dreamux-utils",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/dreamux",
      "projectFolder": "packages/dreamux",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/feishu-transport",
      "projectFolder": "packages/channel/feishu-transport",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/feishu-channel",
      "projectFolder": "packages/channel/feishu-channel",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/agent-runtime-codex",
      "projectFolder": "packages/agent-runtime/codex",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/agent-runtime-claude-code",
      "projectFolder": "packages/agent-runtime/claude-code",
      "shouldPublish": true
    },
    {
      "packageName": "@excitedjs/agent-runtime-kimi-code",
      "projectFolder": "packages/agent-runtime/kimi-code",
      "shouldPublish": true
    }
  ]
}
